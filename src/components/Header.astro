---
import { IconMoonFilled, IconSearch, IconSunFilled } from "@tabler/icons-astro";
import { SITE_TITLE } from "../consts";

const basePath = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<header class="bg-white text-[#111]">
  <nav
    aria-label="Main navigation"
    class="mx-auto box-border flex min-h-22 max-w-7xl items-center justify-between gap-8 px-11 py-6 max-[600px]:flex-wrap max-[600px]:gap-5 max-[600px]:px-6"
  >
    <a
      class="rounded-sm text-2xl leading-none font-bold text-inherit! no-underline transition-colors hover:text-(--accent)! focus-visible:text-(--accent)! focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-current"
      href={basePath}>{SITE_TITLE}</a
    >
    <div
      class="flex items-center gap-5 max-[600px]:w-full max-[600px]:flex-wrap max-[600px]:justify-between max-[600px]:gap-3"
    >
      <div
        class="flex items-center gap-6 text-base leading-6 font-bold max-[600px]:flex-wrap max-[600px]:gap-4"
      >
        <span class="transition-colors hover:text-(--accent)">Blog</span>
        <span class="transition-colors hover:text-(--accent)">Tags</span>
        <a
          href={`${basePath}projects`}
          class="rounded-sm text-inherit! no-underline transition-colors hover:text-(--accent)! focus-visible:text-(--accent)! focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-current"
          >Projects</a
        >
        <a
          href={`${basePath}about`}
          class="rounded-sm text-inherit! no-underline transition-colors hover:text-(--accent)! focus-visible:text-(--accent)! focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-current"
          >About</a
        >
      </div>
      <div class="flex items-center gap-2">
        <button
          type="button"
          aria-label="Search"
          aria-disabled="true"
          class="box-border inline-flex size-10 items-center justify-center rounded-sm border-0 bg-transparent p-2 text-inherit focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-current"
        >
          <IconSearch
            class="shrink-0"
            size={24}
            stroke={1.5}
            aria-hidden="true"
          />
        </button>
        <button
          type="button"
          aria-label="Change theme"
          aria-disabled="true"
          class="box-border inline-flex size-10 items-center justify-center rounded-sm border-0 bg-transparent p-2 text-inherit focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-current"
        >
          <IconSunFilled class="shrink-0" size={24} aria-hidden="true" />
          <!-- Dark mode icon -->
          <IconMoonFilled
            class="hidden shrink-0"
            size={24}
            aria-hidden="true"
          />
        </button>
      </div>
    </div>
  </nav>
</header>
