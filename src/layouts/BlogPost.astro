---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import ImageLightbox from "../components/ImageLightbox.astro";
import "../styles/details.css";

type Props = CollectionEntry<"blog">["data"];

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  showHeroImage = true,
} = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={heroImage} />
    <style>
      main {
        box-sizing: border-box;
        width: 100%;
        max-width: 768px;
        margin: 0 auto;
        padding: 3em 16px;
      }
      .hero-image {
        width: 100%;
      }
      .hero-image img {
        display: block;
        margin: 0 auto;
        border-radius: 12px;
      }
      .prose {
        width: 100%;
        margin: auto;
        color: rgb(var(--gray-dark));
      }
      .article-title {
        font-size: clamp(2rem, 4vw, 3.25rem);
      }
      .prose :global(h2) {
        font-size: clamp(1.625rem, 2.5vw, 2.125rem);
      }
      .prose :global(h3) {
        font-size: clamp(1.375rem, 2vw, 1.75rem);
      }
      .prose :global(h4) {
        font-size: 1.25rem;
      }
      .prose :global(h5) {
        font-size: 1.1875rem;
      }
      .prose :global(h6) {
        font-size: 1.125rem;
      }
      .prose :global(table) {
        width: 100%;
        table-layout: fixed;
        border-collapse: collapse;
        margin-block: 1.5rem;
        font-size: 16px;
        line-height: 1.65;
      }
      .prose :global(th),
      .prose :global(td) {
        padding: 14px 18px 14px 0;
        vertical-align: top;
        overflow-wrap: anywhere;
      }
      .prose :global(thead th) {
        padding-top: 6px;
        border-bottom: 2px solid var(--color-pink-600);
        color: var(--color-zinc-600);
        font-size: 13px;
        font-weight: 700;
      }
      .prose :global(tbody th),
      .prose :global(tbody td) {
        border-bottom: 1px solid var(--color-zinc-200);
      }
      .prose :global(tbody > tr > :first-child) {
        font-weight: 700;
      }
      .prose
        :global(
          table:has(thead tr > :nth-child(2):last-child) tr > :first-child
        ) {
        width: 31%;
      }
      .prose :global(table code) {
        padding: 3px 5px;
        border-radius: 4px;
        background: #f1f1f4;
        color: var(--color-zinc-700);
        font-size: 0.82em;
        -webkit-box-decoration-break: clone;
        box-decoration-break: clone;
      }
      .prose :global(table em) {
        color: var(--color-zinc-600);
      }
      @media (min-width: 640px) {
        main {
          padding-inline: 24px;
        }
      }
      @media (max-width: 720px) {
        main {
          padding-block: 1em;
        }
      }
      @media (max-width: 480px) {
        .prose :global(table) {
          font-size: 15px;
        }
        .prose :global(th),
        .prose :global(td) {
          padding: 12px 10px 12px 0;
        }
        .prose
          :global(
            table:has(thead tr > :nth-child(2):last-child) tr > :first-child
          ) {
          width: 35%;
        }
      }
      @media (min-width: 1280px) {
        main {
          max-width: 1024px;
          padding-inline: 0;
        }
        .prose :global(img:not([data-expandable])),
        .prose :global(.expandable-image) {
          display: block;
          max-width: 56%;
          height: auto;
          margin-inline: auto;
        }
      }
      .prose :global(table .expandable-image),
      .prose :global(table img) {
        display: block;
        width: 100%;
        max-width: 100%;
        height: auto;
      }
      .prose :global(table .expandable-image) {
        margin: 14px 0 0;
      }
    </style>
  </head>

  <body>
    <Header />
    <main>
      <article>
        {
          showHeroImage && heroImage && (
            <div class="hero-image">
              <Image width={1020} height={510} src={heroImage} alt="" />
            </div>
          )
        }
        <div class="prose">
          <header class="mt-8 mb-12 text-left">
            <h1
              class="article-title m-0 leading-[1.15] font-bold tracking-tight text-zinc-900"
            >
              {title}
            </h1>
            <div
              class="mt-5 flex flex-wrap items-baseline gap-x-3 gap-y-1 text-sm text-zinc-500"
            >
              <span class:list={{ "opacity-75": Boolean(updatedDate) }}>
                Published <FormattedDate date={pubDate} />
              </span>
              {
                updatedDate && (
                  <span class="inline-flex flex-wrap items-baseline gap-x-3">
                    <span aria-hidden="true" class="text-zinc-300">
                      ·
                    </span>
                    <span>
                      Updated <FormattedDate date={updatedDate} />
                    </span>
                  </span>
                )
              }
            </div>
          </header>
          <slot />
        </div>
      </article>
    </main>
    <ImageLightbox />
    <Footer />
  </body>
</html>
