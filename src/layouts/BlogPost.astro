---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import HeadingPermalinks from "../components/HeadingPermalinks.astro";
import ImageLightbox from "../components/ImageLightbox.astro";
import "../styles/details.css";

type Props = CollectionEntry<"blog">["data"];

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  showHeroImage = true,
} = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={heroImage} />
    <style>
      main {
        box-sizing: border-box;
        width: 100%;
        max-width: 768px;
        margin: 0 auto;
        padding: 3em 16px;
      }
      .hero-image {
        width: 100%;
      }
      .hero-image img {
        display: block;
        margin: 0 auto;
        border-radius: 12px;
      }
      .prose {
        width: 100%;
        margin: auto;
        color: rgb(var(--gray-dark));
      }
      .article-title {
        font-size: clamp(2rem, 4vw, 3.25rem);
      }
      .prose :global(:is(h1, h2, h3, h4, h5, h6):not(.article-title)) {
        margin-block-start: 2.5rem;
      }
      .prose :global(h2) {
        font-size: clamp(1.625rem, 2.5vw, 2.125rem);
      }
      .prose :global(h3) {
        font-size: clamp(1.375rem, 2vw, 1.75rem);
      }
      .prose :global(h4) {
        font-size: 1.25rem;
      }
      .prose :global(h5) {
        font-size: 1.1875rem;
      }
      .prose :global(h6) {
        font-size: 1.125rem;
      }
      @media (min-width: 640px) {
        main {
          padding-inline: 24px;
        }
      }
      @media (max-width: 720px) {
        main {
          padding-block: 1em;
        }
      }
      @media (min-width: 1280px) {
        main {
          max-width: 1024px;
          padding-inline: 0;
        }
        .prose :global(img:not([data-expandable])),
        .prose :global(.expandable-image) {
          display: block;
          max-width: 56%;
          height: auto;
          margin-inline: auto;
        }
        .prose :global(img[data-wide]),
        .prose :global(.expandable-image:has(img[data-wide])) {
          width: 100%;
          max-width: 100%;
          height: auto;
        }
        .prose :global(.image-figure) {
          max-width: 56%;
        }
        .prose :global(.image-figure:has(img[data-wide])) {
          max-width: 100%;
        }
        .prose :global(.image-figure img),
        .prose :global(.image-figure .expandable-image) {
          max-width: 100%;
        }
      }
      .prose :global(table .expandable-image),
      .prose :global(table img),
      .prose :global(table .image-figure) {
        display: block;
        width: 100%;
        max-width: 100%;
        height: auto;
      }
      .prose :global(table .expandable-image) {
        margin: 14px 0 0;
      }
    </style>
  </head>

  <body>
    <Header />
    <main>
      <article>
        {
          showHeroImage && heroImage && (
            <div class="hero-image">
              <Image width={1020} height={510} src={heroImage} alt="" />
            </div>
          )
        }
        <div class="prose">
          <header class="mt-8 mb-12 text-left">
            <h1
              class="article-title m-0 leading-[1.15] font-bold tracking-tight text-zinc-900"
            >
              {title}
            </h1>
            <div
              class="mt-5 flex flex-wrap items-baseline gap-x-3 gap-y-1 text-sm text-zinc-500"
            >
              <span class:list={{ "opacity-75": Boolean(updatedDate) }}>
                Published <FormattedDate date={pubDate} />
              </span>
              {
                updatedDate && (
                  <span class="inline-flex flex-wrap items-baseline gap-x-3">
                    <span aria-hidden="true" class="text-zinc-300">
                      ·
                    </span>
                    <span>
                      Updated <FormattedDate date={updatedDate} />
                    </span>
                  </span>
                )
              }
            </div>
          </header>
          <slot />
        </div>
      </article>
    </main>
    <HeadingPermalinks />
    <ImageLightbox />
    <Footer />
    <script>
      // all images on widescreens are limited in width. But for wide images that will look
      // weird. This script will make those image appear the same width as the content.
      // Logic: Image that have width 1.8 greater than the height will consider as wide image.
      // See https://github.com/iqfareez/websitev3/pull/5
      document
        .querySelectorAll<HTMLImageElement>(".prose img")
        .forEach((image) => {
          if (image.closest("table, article-image-carousel")) return;

          const updateImageWidth = () => {
            const width =
              image.naturalWidth || Number(image.getAttribute("width"));
            const height =
              image.naturalHeight || Number(image.getAttribute("height"));
            image.toggleAttribute(
              "data-wide",
              width > 0 && height > 0 && width >= 1.8 * height,
            );
          };

          updateImageWidth();
          image.addEventListener("load", updateImageWidth);
        });
    </script>
  </body>
</html>
