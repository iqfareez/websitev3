---
import { getCollection } from "astro:content";
import FormattedDate from "../../components/FormattedDate.astro";
import Page from "../../layouts/Page.astro";

const basePath = import.meta.env.BASE_URL.replace(/\/?$/, "/");

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const postsByYear = new Map<number, typeof posts>();
for (const post of posts) {
  const year = post.data.pubDate.getUTCFullYear();
  const yearPosts = postsByYear.get(year) ?? [];
  yearPosts.push(post);
  postsByYear.set(year, yearPosts);
}
---

<Page
  title="Blog"
  description="Thoughts by me. Mostly about techs, but sometimes other things like life etc."
>
  <div class="max-w-2xl space-y-8">
    {
      Array.from(postsByYear, ([year, yearPosts]) => (
        <section aria-labelledby={`year-${year}`}>
          <h3 id={`year-${year}`} class="mb-4 text-xl">
            {year}
          </h3>
          <ul class="m-0 list-none space-y-2 p-0" role="list">
            {yearPosts.map((post) => (
              <li class="grid grid-cols-1 items-baseline gap-x-3 gap-y-1 sm:grid-cols-[6.5rem_1fr]">
                <span class="text-sm text-[rgb(var(--gray))]">
                  <FormattedDate date={post.data.pubDate} />
                </span>
                <a
                  class="min-w-0 text-(--accent) no-underline visited:text-[color-mix(in_srgb,var(--accent)_50%,var(--color-zinc-50))] hover:text-(--accent-dark)"
                  href={`${basePath}blog/${post.id}`}
                >
                  {post.data.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Page>
