---
import { getEntry } from "astro:content";
import { Font } from "astro:assets";
import ExperienceEntry from "../../components/cv/ExperienceEntry.astro";
import "../../styles/cv.css";

const entry = await getEntry("cv", "cv");
if (!entry) throw new Error("CV data is missing");

const cv = entry.data;
const [firstName, ...lastNames] = cv.name.split(" ");
const pageTitle = `${cv.name} | CV`;
const siteUrl = new URL("/", Astro.site).href;
const pdfName = `${cv.name.toLowerCase().replace(/[^a-z0-9]+/g, "-")}-cv.pdf`;
const inlineStyles = `:root { --accent: ${cv.accent}; } @page { @bottom-center { content: "${cv.name} · Curriculum Vitae · " counter(page); } }`;
const displayUrl = (url: string) =>
  url.replace(/^https?:\/\/(www\.)?/, "").replace(/\/$/, "");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#e9eaec" />
    <meta name="description" content={cv.summary} />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={cv.summary} />
    <meta property="og:url" content={siteUrl} />
    <link rel="canonical" href={siteUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <Font cssVariable="--font-source-sans-3" preload />
    <style is:inline set:html={inlineStyles}></style>
  </head>
  <body>
    {
      cv.demo && (
        <p class="demo-notice screen-only">
          Sample CV for the{" "}
          <a href="https://github.com/sht/astro-awesome-cv">astro-awesome-cv</a>{" "}
          Astro theme. Use it for your own CV, it's free and open source.
        </p>
      )
    }
    <main class="page">
      <header class="cv-header">
        <h1>
          <span class="first-name">{firstName}</span>
          {lastNames.join(" ")}
        </h1>
        <p class="position">{cv.role}</p>
        <ul class="contact">
          <li>{cv.location}</li>
          <li><a href={`mailto:${cv.contact.email}`}>{cv.contact.email}</a></li>
          <li>
            <a href={cv.contact.linkedin}>{displayUrl(cv.contact.linkedin)}</a>
          </li>
          <li>
            <a href={cv.contact.github}>{displayUrl(cv.contact.github)}</a>
          </li>
        </ul>
        <a class="download screen-only" href="/cv.pdf" download={pdfName}
          >Download PDF</a
        >
      </header>

      <section>
        <h2><span class="highlight">Summary</span></h2>
        <p class="detail">{cv.summary}</p>
      </section>

      <section>
        <h2><span class="highlight">Experience</span></h2>
        {
          cv.experience.map((employer) => (
            <ExperienceEntry employer={employer} />
          ))
        }
      </section>

      <section>
        <h2><span class="highlight">Projects</span></h2>
        {
          cv.projects.map((item) => (
            <div class="project">
              <h3>{item.title}</h3>
              <p class="detail">{item.description}</p>
            </div>
          ))
        }
      </section>

      <section>
        <h2><span class="highlight">Skills</span></h2>
        <dl class="skills">
          {
            cv.skills.map((group) => (
              <>
                <>
                  <dt>{group.category}</dt>
                  <dd>{group.items}</dd>
                </>
              </>
            ))
          }
        </dl>
      </section>

      <section>
        <h2><span class="highlight">Education</span></h2>
        {
          cv.education.map((item) => (
            <div class="entry">
              <div class="entry-heading">
                <>
                  <h3>{item.degree}</h3>
                  <span class="date">{item.dates}</span>
                </>
              </div>
              <p class="subtitle">{item.institution}</p>
              {item.note && <p class="detail">{item.note}</p>}
            </div>
          ))
        }
      </section>

      <section class="two-col">
        <div>
          <h2><span class="highlight">Recognition</span></h2>
          {
            cv.recognition.map((item) => (
              <div class="entry">
                <>
                  <h3>{item.title}</h3>
                  <p class="detail">{item.note}</p>
                </>
              </div>
            ))
          }
        </div>
        <div>
          <h2><span class="highlight">Languages</span></h2>
          <p class="detail">{cv.languages}</p>
        </div>
      </section>
    </main>
  </body>
</html>
