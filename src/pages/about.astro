---
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import {
  IconBrandGithubFilled,
  IconBrandLinkedinFilled,
  IconBrandX,
  IconMailFilled,
} from "@tabler/icons-astro";
import avatar from "../assets/images/avatar.jpg";
import Page from "../layouts/Page.astro";

const cv = await getEntry("cv", "cv");
if (!cv) throw new Error("CV contact details are missing");

const socialLinks = [
  {
    label: "Email Fareez",
    href: `mailto:${cv.data.contact.email}`,
    icon: IconMailFilled,
  },
  {
    label: "Fareez on GitHub",
    href: cv.data.contact.github,
    icon: IconBrandGithubFilled,
  },
  {
    label: "Fareez on LinkedIn",
    href: cv.data.contact.linkedin,
    icon: IconBrandLinkedinFilled,
  },
  { label: "Fareez on X", href: "https://x.com/iqfareez", icon: IconBrandX },
];
---

<Page
  title="About"
  documentTitle="About | Muhammad Fareez Iqmal"
  description="Meet Muhammad Fareez Iqmal, a software engineer building web systems and mobile applications with Flutter, Laravel, and .NET."
  image={avatar}
>
  <div
    class="grid grid-cols-[312px_minmax(0,1fr)] items-start gap-10 max-[800px]:mx-auto max-[800px]:max-w-2xl max-[800px]:grid-cols-1 max-[800px]:gap-9"
  >
    <section class="text-center" aria-labelledby="profile-name">
      <Image
        class="mx-auto mt-0 mb-4.5 block size-48 rounded-full object-cover"
        src={avatar}
        alt="Muhammad Fareez Iqmal"
        width={192}
        height={192}
        widths={[192, 384, 576]}
        sizes="192px"
        fit="cover"
        loading="eager"
      />
      <h2 class="m-0 text-2xl leading-[1.35] text-black" id="profile-name">
        Muhammad Fareez
      </h2>
      <p class="mt-2 mb-5 text-[rgb(var(--gray))]">Software Engineer</p>
      <nav class="flex justify-center" aria-label="Contact and social profiles">
        {
          socialLinks.map(({ label, href, icon: Icon }) => (
            <a
              class="inline-flex size-11 items-center justify-center rounded-sm text-[#374151] transition-colors duration-150 hover:text-(--accent) focus-visible:text-(--accent) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current"
              href={href}
              aria-label={label}
              title={label}
            >
              <Icon size={32} stroke={1.8} aria-hidden="true" />
            </a>
          ))
        }
      </nav>
      <a
        class="mt-5 inline-block text-base leading-[1.65] text-(--accent) underline underline-offset-3 transition-colors duration-150 hover:text-(--accent-dark) focus-visible:text-(--accent-dark) focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-current"
        href="/cv">Open CV</a
      >
    </section>

    <div>
      <p class="m-0 mb-6">
        Fareez is a Software Engineer with experience in full-stack development,
        specializing in Flutter, Laravel, and .NET stack. He is currently
        developing web systems and mobile applications, committed to delivering
        high-quality, scalable, and maintainable software.
      </p>
      <p class="m-0 mb-6">
        With a background in Mechatronics Engineering from IIUM, Fareez has a
        keen interest in mobile app development, IoT systems, robotics, and
        electronic projects. He is also passionate about DevOps, CI/CD, and
        leveraging technology to build innovative solutions.
      </p>
      <p class="m-0">
        Outside of work, I build and maintain personal projects, including Waktu
        Solat app, etc. These projects give me room to explore ideas and work
        across the whole development process. I'm particularly interested in
        creating useful tools for everyday life, while improving how I write,
        test, and deliver software.
      </p>
    </div>
  </div>
</Page>
